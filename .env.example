# Browser-safe project settings. Copy these two values into .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set these as Supabase Edge Function secrets, not in a Vite env file.
# Optional: add the confirmed teacher UUID only when enabling the dashboard.
STORY_TEACHER_USER_ID=
STORY_ALLOWED_ORIGINS=
STORY_FRONTEND_URL=
STORY_EMAIL_FROM=
RESEND_API_KEY=
STORY_RATE_LIMIT_SALT=
STORY_MAINTENANCE_KEY=
STORY_MAX_VIDEO_BYTES=200000000
# Optional override for self-hosted or local Supabase.
STORY_STORAGE_URL=
